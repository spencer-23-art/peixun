# 数据库与上传隐私文件（防泄漏极其重要）
peixun.db
training.db
*.db
uploads/
*.zip
local_deps_backup/

# 运行日志（含请求记录与可能的 token，勿入库）
*.log
app_stdout.log

# TLS 证书与私钥
*.pem
cert.pem
key.pem
# Android 仅内置这张公开 CA 证书；服务器私钥仍只保存在 /data/peixun/tls。
!android-app/app/src/main/res/raw/peixun_private_ca.pem

# 导出产物（运行时生成）
training_records_export.*
photos_export.zip

# WorkBuddy 工作元数据（含对话/记忆/任务，勿入库）
.workbuddy/

# 临时调试文件与草稿目录
scratch/
debug_*.html
test_*.docx
test_*.log

# 登记卡模板（含敏感样式，按需本地放置）
登记卡.docx

# 根目录散落的题库临时副本（实际题库在 shiti/ 目录）
/普工试题*.xlsx
/焊工题库*.xlsx
/探伤*.xlsx
/06.03.*

# 题库是服务器挂载的运行数据，管理员可在服务器端更新，禁止随 Git 同步覆盖。
shiti/*.xlsx

# Python 编译缓存
__pycache__/
*.pyc
*.pyo
*.pyd

# 编辑器与系统临时文件
.idea/
.vscode/
.DS_Store
Thumbs.db
