<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- The app trusts only the private CA bundled below; cleartext is disabled. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="@raw/peixun_private_ca" />
        </trust-anchors>
    </base-config>
</network-security-config>
