[Unit]
Description=Peixun Celery Worker (OCR Tasks)
After=network.target redis-server.service
Requires=redis-server.service

[Service]
Type=simple
User=root
WorkingDirectory=/root/peixun
ExecStart=/usr/bin/python3 -m celery -A app.celery_app worker --loglevel=info --pool=solo --concurrency=2
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
